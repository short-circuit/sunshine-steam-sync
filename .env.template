# sunshine-steam-sync configuration
# Copy this file to .env and fill in your values.
# All paths have OS-specific defaults — only override if non-standard.

# SteamGridDB API key (get from https://www.steamgriddb.com/profile/preferences)
# Optional — without it games are added without grid artwork.
STEAMGRIDDB_API_KEY="your_api_key_here"

# Standard paths (Linux defaults shown; Windows in comments)
# STEAM_LIBRARY_VDF="~/.local/share/Steam/steamapps/libraryfolders.vdf"
# Windows: %PROGRAMFILES(X86)%\Steam\steamapps\libraryfolders.vdf

# SUNSHINE_APPS_JSON="~/.config/sunshine/apps.json"
# Windows: %APPDATA%\sunshine\config\apps.json

# SUNSHINE_GRIDS="~/.config/sunshine/grids"
# Windows: %APPDATA%\sunshine\config\grids

# Executable paths for auto-restart (optional)
# STEAM_EXE="/usr/bin/steam"
# Windows: %PROGRAMFILES(X86)%\Steam\steam.exe

# SUNSHINE_EXE="/usr/bin/sunshine"
# Windows: %PROGRAMFILES%\Sunshine\sunshine.exe
